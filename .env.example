# Invite code needed to create an account. Leave empty to allow anyone who
# can reach the server to register (not recommended on a public domain).
REGISTRATION_CODE=zmen-me-na-tajne-heslo

# Max size of one uploaded file, in megabytes.
MAX_UPLOAD_MB=500

# Comma separated STUN/TURN servers for calls.
# For calls across strict NATs add a TURN server with credentials, e.g.
# turn:turn.example.com:3478|user|password  (separate with commas)
ICE_SERVERS=stun:stun.l.google.com:19302

VERSION=0.1.0
DOMAIN=melvin.example.com
